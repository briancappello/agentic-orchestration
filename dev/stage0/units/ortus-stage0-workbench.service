[Unit]
Description=Ortus Nova stage 0: the plan workbench
After=ortus-stage0-sortie.service

[Service]
Type=exec
Environment=STAGE0_HOME=@STAGE0_HOME@
ExecStart=@KIT@/run-workbench.sh
Restart=on-failure
RestartSec=10
# Planning sessions run in a detached driver; ending the backend keeps them.
KillMode=process

[Install]
WantedBy=default.target
