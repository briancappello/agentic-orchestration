[Unit]
Description=Ortus Nova stage 0: Sortie under plan control (co-located smolvm)
After=podman-restart.service network-online.target

[Service]
Type=exec
Environment=STAGE0_HOME=@STAGE0_HOME@
ExecStart=@KIT@/run-sortie.sh
Restart=on-failure
RestartSec=30
# Sortie drains running sessions on SIGTERM; give it time.
TimeoutStopSec=120

[Install]
WantedBy=default.target
