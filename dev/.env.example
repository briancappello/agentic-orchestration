# Settings for dev/dev.sh. Copy this file to dev/.env (which git ignores)
# and change what you need; the environment overrides both. The values
# shown are the defaults. Relative paths are from the repository root.

# Sources to build, and where the binaries go.
#SORTIE_SRC=sortie
#BROKER_SRC=acp-broker
#DEV_BIN=.bin

# The environment's state: the workbench home, its spec store, Sortie's run
# directory, and the planning sessions. --reset empties it.
#DEV_HOME=.dev

# Huly: where it answers, and the compose setup that starts it when it does not.
#HULY_URL=http://localhost:8087
#HULY_COMPOSE_DIR=$HOME/dev/huly-selfhost
#HULY_WORKSPACE=sortie
#HULY_PROJECT=DEV
#HULY_EMAIL=sortie@example.com
#HULY_PASSWORD=sortie-dev-pass

# The workers' agent: mock, Sortie's mock agent; or acp, dev/mock_acp_agent.py
# behind acp-broker, so the workbench can watch and steer them.
#DEV_AGENT=mock

# The local Gitea repository the mock agent's pull requests open in.
#FORGE_REPO=dev-lab
#GITEA_PORT=3001

# Secrets dev.sh creates on first run: Sortie's control token, and the hash
# of the password you sign in to the workbench with.
#SORTIE_TOKEN_FILE=$HOME/.config/plan-workbench-sortie-token
#PASSWORD_HASH_FILE=$HOME/.config/plan-workbench-password-hash

# Ports.
#SORTIE_PORT=7678
#WB_PORT=8790
#VITE_PORT=5173
